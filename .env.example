# Copy to .env.local. Values below are the well-known keys printed by `npx supabase start` for LOCAL development only.
# For a hosted Supabase project use the values from Project Settings > API instead.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Safe to expose to the browser (it is restricted by row-level security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for the AI cache table and nothing else.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# SERVER ONLY. Optional Groq key (preferred when set). Without any AI key every AI feature falls back to the plain skill-overlap result.
GROQ_API_KEY=

# SERVER ONLY. Optional Anthropic key, used when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-5-5 (small and fast; every AI output here is short).
# ANTHROPIC_MODEL=claude-haiku-5-5
